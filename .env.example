# Generate a local credential with: python -m server.configure
# Authenticated accounts are provisioned server-side; never put plaintext tokens in this JSON.
SHIPCOURT_IDENTITIES=[]
SHIPCOURT_TOKEN=
SHIPCOURT_STATE_PATH=.runtime/shipcourt.sqlite3
# Set only for an HTTPS deployment behind the private reverse proxy.
SHIPCOURT_PUBLIC_ORIGIN=
# Generate with python -m server.configure --hook frontend-agent.
# Export these to the actual editor/hook process as well.
SHIPCOURT_HOOK_TOKEN=
SHIPCOURT_AGENT_ID=frontend-agent
SHIPCOURT_COORDINATOR_URL=http://127.0.0.1:8080
SHIPCOURT_WORKSPACE_ROOT=

# Courtroom inference: one Groq key is sufficient; optional backups use the same model.
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
DEFAULT_GROQ_MODEL=

# GitHub: fine-grained token restricted to the selected test repository.
GITHUB_TOKEN=

# Discord text gateway (optional). Enable Message Content Intent in the developer portal.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Exact Discord user ID -> server-side roles and scopes. No display-name aliases.
DISCORD_MEMBERS={}
# HTTP interactions are optional when the gateway is used; requires a public HTTPS URL.
DISCORD_PUBLIC_KEY=

# Official Switch agent bridge, registered agents and exact participant IDs.
SWITCH_URL=
SWITCH_REGISTRATION_TOKEN=
# Native Groq clients: runtime=groq_custom; role=clerk,historian,prosecutor,defender,third_voice.
# Additional fields: mention=@registered-name and sender_id=<server-recorded transport ID>.
# Example entry: {"url":"https://bridge.example","agent_id":"registered-id","key_env":"SWITCH_CLERK_KEY","room_id":"opaque-room-id","role":"clerk","reviewer_mention":"@registered-reviewer"}
SWITCH_CLIENTS=[]
SWITCH_PARTICIPANTS={}
SWITCH_CLERK_KEY=
SWITCH_REVIEWER_KEY=
SWITCH_HISTORIAN_KEY=
SWITCH_PROSECUTOR_KEY=
SWITCH_DEFENDER_KEY=
SWITCH_THIRD_VOICE_KEY=

# Optional: operator-selected staging health endpoint, NEVER a production URL.
SHIPCOURT_STAGING_URL=

# Optional voice gateway (Node >=24.17), separate bot application recommended.
DISCORD_VOICE_BOT_TOKEN=
SHIPCOURT_VOICE_TOKEN=
SHIPCOURT_URL=http://127.0.0.1:8080
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=en
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
# Research uses only explicitly allowlisted hosts; redirects are refused.
SHIPCOURT_RESEARCH_HOSTS=docs.switchagents.ai,docs.github.com
