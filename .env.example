# Ship Court Environment Configuration
# Copy this file to .env and provide your API keys

# Switch Platform
SWITCH_BASE_URL=http://localhost:8000
SWITCH_API_KEY=your_switch_api_key_here
SWITCH_TEAM_PREFIX=shipcourt
SWITCH_ROOM_NAME=ship-court

# Team Chat Bridge (Mattermost / Slack / Discord / Teams)
CHAT_BRIDGE_TYPE=mattermost
MATTERMOST_URL=http://localhost:8065
MATTERMOST_TOKEN=your_mattermost_token_here
MATTERMOST_BOT_TOKEN=your_mattermost_bot_token_here
MATTERMOST_CHANNEL_ID=your_mattermost_channel_id_here

# Code & Repository Evidence
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPOSITORY=acme/shop

# Web & Scraping Engine (Firecrawl / Browserless / Playwright)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# AI LLM Model Providers (Claude Code / OpenAI / Gemini / OpenCode)
DEFAULT_AI_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO
